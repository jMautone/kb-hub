{
  "name": "kb-hub",
  "version": "0.0.0",
  "description": "A markdown knowledge vault for coding agents, served over MCP, with git provenance for every captured note.",
  "type": "module",
  "bin": {
    "kb-hub": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run build && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "knowledge-base",
    "llm-wiki",
    "claude-code",
    "agents",
    "markdown"
  ],
  "author": "Nacho Mautone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jMautone/kb-hub.git"
  },
  "homepage": "https://github.com/jMautone/kb-hub#readme",
  "bugs": "https://github.com/jMautone/kb-hub/issues",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
